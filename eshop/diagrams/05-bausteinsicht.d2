# Bausteinsicht Ebene 1 (Whitebox eShop)  --  arc42 Kapitel 5
#
# Notation: UML-Komponentendiagramm.
#   «component»        Baustein des eShops
#   «external system»  Nachbarsystem
#   Pakete             Systemgrenze bzw. Eigentumsverhaeltnisse
#   gestrichelte Pfeile  UML-Abhaengigkeit «use»
#
# Der Zuschnitt folgt der Qualitaetsanforderung, dass Bestellung, Konfiguration,
# GUI und die Integration mit externen Systemen austauschbar sein sollen.
#
# Rendern: siehe render.sh in diesem Verzeichnis.

direction: down

kunde: "«actor»\nKunde" {
  shape: person
  style.fill: "#eef2f7"
  style.stroke: "#40506b"
}

eshop: "«system» eShop" {
  shape: package
  style: {
    fill: "#f7f9fd"
    stroke: "#1a3f8f"
    stroke-width: 3
    font-color: "#1a3f8f"
    font-size: 20
    bold: true
  }

  ui: "«component»\nWeb-UI" {
    style.fill: "#1a3f8f"
    style.stroke: "#122c66"
    style.font-color: "#ffffff"
  }

  konfigurator: "«component»\nKonfigurator" {
    style.fill: "#1a3f8f"
    style.stroke: "#122c66"
    style.font-color: "#ffffff"
  }

  bestellung: "«component»\nBestellung" {
    style.fill: "#1a3f8f"
    style.stroke: "#122c66"
    style.font-color: "#ffffff"
  }

  integration: "«component»\nIntegration" {
    style.fill: "#3b63b5"
    style.stroke: "#122c66"
    style.font-color: "#ffffff"
  }

  ui -> konfigurator: "«use» prüfen, bepreisen" {
    style.stroke-dash: 4
  }
  ui -> bestellung: "«use» bestellen, Status" {
    style.stroke-dash: 4
  }
  konfigurator -> integration: "«use» Verfügbarkeit" {
    style.stroke-dash: 4
  }
  bestellung -> integration: "«use» Kunde, Reservierung, Zahlung" {
    style.stroke-dash: 4
  }
}

inhouse: "in-house" {
  shape: package
  style: {
    fill: "#eaf0fb"
    stroke: "#1a3f8f"
    stroke-width: 2
    font-color: "#1a3f8f"
    bold: true
  }

  kundenverwaltung: "«external system»\nKundenverwaltung" {
    style.fill: "#ffffff"
    style.stroke: "#1a3f8f"
    style.stroke-width: 2
  }

  bestandsverwaltung: "«external system»\nBestandsverwaltung" {
    style.fill: "#ffffff"
    style.stroke: "#1a3f8f"
    style.stroke-width: 2
  }
}

extern: "zugekauft" {
  shape: package
  style: {
    fill: "#faf6ee"
    stroke: "#9a8558"
    stroke-width: 2
    font-color: "#6f5f3c"
    bold: true
  }

  bezahldienst: "«external system»\nBezahldienst" {
    style.fill: "#ffffff"
    style.stroke: "#9a8558"
    style.stroke-width: 2
  }
}

kunde -> eshop.ui
eshop.integration -> inhouse.kundenverwaltung: "«use»" {
  style.stroke-dash: 4
  style.font-color: "#2b3445"
}
eshop.integration -> inhouse.bestandsverwaltung: "«use»" {
  style.stroke-dash: 4
  style.font-color: "#2b3445"
}
eshop.integration -> extern.bezahldienst: "«use»" {
  style.stroke-dash: 4
  style.stroke: "#9a8558"
  style.font-color: "#6f5f3c"
}
