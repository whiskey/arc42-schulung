# Laufzeitszenario 2: Bestellung aufgeben und bezahlen  --  arc42 Kapitel 6
#
# Notation: UML-Sequenzdiagramm mit Aktivierungsbalken und alt-Fragment.
# Der Punkt des Szenarios ist die Klammer um Reservierung und Zahlung: die
# Reservierung geht der Zahlung voraus und muss zurueckgenommen werden, wenn
# die Zahlung scheitert.
#
# Achtung: Spans duerfen nicht wie eine Lebenslinie heissen. Ein Span
# integration.kunde wuerde auf die Lebenslinie kunde aufgeloest.
#
# Rendern: siehe render.sh in diesem Verzeichnis.

shape: sequence_diagram

kunde: "«actor»\nKunde"
ui: "«component»\nWeb-UI"
bestellung: "«component»\nBestellung"
integration: "«component»\nIntegration"
kundenverwaltung: "«external system»\nKundenverwaltung"
bestand: "«external system»\nBestandsverwaltung"
bezahldienst: "«external system»\nBezahldienst"

kunde -> ui.aktiv: "schließt Bestellung ab"
ui.aktiv -> bestellung.vorgang: "Bestellung auslösen"

bestellung.vorgang -> integration.stammdaten: "Kundenstammdaten holen"
integration.stammdaten -> kundenverwaltung.lesen: "Stammdaten lesen"
kundenverwaltung.lesen -> integration.stammdaten: "Stammdaten"

bestellung.vorgang -> integration.res: "Komponenten reservieren"
integration.res -> bestand.res: "reservieren"
bestand.res -> integration.res: "Reservierung bestätigt"

bestellung.vorgang -> integration.zahlung: "Zahlung autorisieren"
integration.zahlung -> bezahldienst.auth: "Zahlungsauftrag"
bezahldienst.auth -> integration.zahlung: "Antwort"

alt: {
  "[Zahlung autorisiert]": {
    bestellung.vorgang -> ui.aktiv: "Bestellung bestätigt"
    ui.aktiv -> kunde: "Bestellbestätigung"
  }

  "[Zahlung abgelehnt]": {
    bestellung.vorgang -> integration.storno: "Reservierung aufheben"
    integration.storno -> bestand.frei: "Reservierung freigeben"
    bestellung.vorgang -> ui.aktiv: "Zahlung fehlgeschlagen"
    ui.aktiv -> kunde: "Hinweis, andere Zahlungsart wählen"
  }
}
