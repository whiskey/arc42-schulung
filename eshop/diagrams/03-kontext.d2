# Fachlicher Kontext des eShop  --  arc42 Kapitel 3
#
# Notation: UML-Komponentendiagramm.
#   «system»           das betrachtete System
#   «external system»  Nachbarsystem ausserhalb des Betrachtungsgegenstands
#   «actor»            menschlicher Benutzer
#   Pakete             Eigentumsverhaeltnisse (in-house vs. zugekauft)
#   gestrichelte Pfeile  UML-Abhaengigkeit (der eShop benutzt den Nachbarn)
#
# Rendern: siehe render.sh in diesem Verzeichnis.

direction: right

kunde: "«actor»\nKunde" {
  shape: person
  style.fill: "#eef2f7"
  style.stroke: "#40506b"
}

eshop: "«system»\neShop" {
  shape: rectangle
  width: 200
  height: 90
  style: {
    fill: "#1a3f8f"
    stroke: "#122c66"
    stroke-width: 2
    font-color: "#ffffff"
    font-size: 18
    bold: true
    border-radius: 6
  }
}

inhouse: "Sell-PC-Solutions (in-house)" {
  shape: package
  style: {
    fill: "#eaf0fb"
    stroke: "#1a3f8f"
    stroke-width: 2
    font-color: "#1a3f8f"
    bold: true
  }

  kundenverwaltung: "«external system»\nKundenverwaltung" {
    style.fill: "#ffffff"
    style.stroke: "#1a3f8f"
    style.stroke-width: 2
  }

  bestandsverwaltung: "«external system»\nBestandsverwaltung" {
    style.fill: "#ffffff"
    style.stroke: "#1a3f8f"
    style.stroke-width: 2
  }
}

extern: "Extern (zugekauft)" {
  shape: package
  style: {
    fill: "#faf6ee"
    stroke: "#9a8558"
    stroke-width: 2
    font-color: "#6f5f3c"
    bold: true
  }

  bezahldienst: "«external system»\nBezahldienst" {
    style.fill: "#ffffff"
    style.stroke: "#9a8558"
    style.stroke-width: 2
  }
}

kunde -> eshop: "konfiguriert und bestellt" {
  style.font-color: "#2b3445"
}
eshop -> inhouse.kundenverwaltung: "«use» Kundenstammdaten" {
  style.stroke-dash: 4
  style.font-color: "#2b3445"
}
eshop -> inhouse.bestandsverwaltung: "«use» Verfügbarkeit, Reservierung" {
  style.stroke-dash: 4
  style.font-color: "#2b3445"
}
eshop -> extern.bezahldienst: "«use» Zahlung autorisieren" {
  style.stroke-dash: 4
  style.stroke: "#9a8558"
  style.font-color: "#6f5f3c"
}
